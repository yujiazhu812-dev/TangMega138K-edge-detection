INS_LOC "u_ddr3/gw3_top/u_ddr_phy_top/fclkdiv" LEFTSIDE[4];
INS_LOC "Gowin_PLL_m0/u_pll/PLL_inst" PLL_L[0];
SET_PARAM "u_ddr3/gw3_top/u_ddr_phy_top/u_dll" CLKIN_SEL=CLKIN5;




// Dock 31005 DVI direction and HPD. HPD is an input, never driven.
IO_LOC "hdmi_tx_en" K14;
IO_PORT "hdmi_tx_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "hdmi_hpd" K13;
IO_PORT "hdmi_hpd" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// v4: Dock KEY0/1/2 active-low, 3.3V. SOM user key active-high, 1.5V.
IO_LOC "key1_n" AB13;
IO_PORT "key1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key2_n" Y12;
IO_PORT "key2_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "core_key" F4;
IO_PORT "core_key" IO_TYPE=LVCMOS15 PULL_MODE=DOWN BANK_VCCIO=1.5;

// v5.5: request global CLOCK distribution, no fixed channel number.
// Net names come from user v5.4 post-PNR report. Preserve all package pins.
// Check PnR Global Clock Signals and MPW report; do not silently fall back.
CLOCK_LOC "cmos_pclk_d" BUFG = CLK;
CLOCK_LOC "clk_d" BUFG = CLK;

// v5.5.5: experimental per-lane reset placement; no timing checks waived.
// Exact instance names verified in user v5.5.4 netlist and STA report.
// Green's already passing site is fixed; the other regions are candidates
// inferred from the right-edge placements, NOT a measured IO-to-GRID map.
// No exclusive reservation: leave surrounding resources available to PnR.
INS_LOC "g_open_dvi.u_tx/lane[0].reset_q_s0" R[102:104]C180;
INS_LOC "g_open_dvi.u_tx/lane[1].reset_q_s0" R101C180[1][A];
INS_LOC "g_open_dvi.u_tx/lane[2].reset_q_s0" R[57:59]C180;
INS_LOC "g_open_dvi.u_tx/lane[3].reset_q_s0" R[104:106]C180;

// Staged reset release near the right-edge serializer reset drivers.
INS_LOC "g_open_dvi.u_tx/reset_release_q_s0" R[78:82]C180;
