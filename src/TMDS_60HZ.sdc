// 2026-10-20: stable source-clock anchor for 109 directly driven reset-only pins.
// The official post-PnR export proves their only drivers are exact equivalents
// of ddr_rsti_reg_2_s0, all on clk. Only these seven original rules use clk.
// The four reset-OR endpoint rules retain their original exact source.
// No endpoint, functional data path, clock period or FIFO delay is added/relaxed.
// Current implementation headers: DDR3 v6.0 and VFB v2.4; IPC labels differ.
// 2026-10-19: merged, endpoint-audited Gowin IP constraints.
// Clocks retain the actual PLL ratios. The explicit memory/UI asynchronous
// exception below imports the manufacturer DDR3 reference abstraction.
// Pixel, TMDS and reset-phase clocks are NOT grouped asynchronously.
// Camera 5.88 ns / 50% waveform is inherited and NOT an interface signoff.
// No sensor IO min/max delays are invented; verify board/sensor waveforms.
// FIFO stage1 bounds and stage2 checks are retained; no global camera cuts.
// Evidence, hashes and reference differences are recorded in reports/.
create_clock -name clk -period 20 -waveform {0 10} [get_ports {clk}] -add
create_generated_clock -name cam_xclk -source [get_ports {clk}] -master_clock clk -divide_by 50  -multiply_by 24 [get_pins {Gowin_PLL_m0/u_pll/PLL_inst/CLKOUT0}]
create_generated_clock -name caux_clk -source [get_ports {clk}] -master_clock clk -divide_by 127 -multiply_by 24 [get_pins {Gowin_PLL_m0/u_pll/PLL_inst/CLKOUT1}]
create_generated_clock -name mem_clk  -source [get_ports {clk}] -master_clock clk -divide_by 3   -multiply_by 24 [get_pins {Gowin_PLL_m0/u_pll/PLL_inst/CLKOUT2}]
create_generated_clock -name clk_tmds_5x -source [get_ports {clk}] -master_clock clk -divide_by 40  -multiply_by 297 [get_pins {u_tmds_pll/u_pll/PLL_inst/CLKOUT0}]
create_generated_clock -name clk_74_25   -source [get_ports {clk}] -master_clock clk -divide_by 200 -multiply_by 297 [get_pins {u_tmds_pll/u_pll/PLL_inst/CLKOUT1}]
create_generated_clock -name clk_x1 -source [get_pins {Gowin_PLL_m0/u_pll/PLL_inst/CLKOUT2}] -master_clock mem_clk -divide_by 4 -multiply_by 1 [get_pins {u_ddr3/gw3_top/u_ddr_phy_top/fclkdiv/CLKOUT}]
// 2026-10-27: the inherited 5.88 ns (170 MHz) came from the vendor's highest
// resolution example. OV5640 DVP cannot reach that rate, and the over-constraint
// made the BSRAM minimum-pulse-width check meaningless: the PCLK net is routed
// generically (PR1014), its falling edge arrives 2.99 ns later than its rising
// edge, so a 2.94 ns half period collapsed to a negative low phase. Constrain the
// real 720p60 pixel beat (74.25 MHz) instead; setup/hold margins only widen.
create_clock -name cmos_pclk -period 13.468 -waveform {0 6.734} [get_ports {cmos_pclk}]
set_false_path -from [get_ports {key0_n key1_n key2_n core_key}]
set_false_path -from [get_regs {u_image_settings/req_s?}] -to [get_pins {u_image_settings/req_meta_s?/D}]
set_false_path -from [get_regs {u_image_settings/ack_s?}] -to [get_pins {u_image_settings/ack_meta_s?/D}]
set_max_delay -from [get_regs {u_image_settings/hold_bus_*}] -to [get_pins {u_image_settings/dst_mode_*/D u_image_settings/dst_threshold_*/D}] 10
set_false_path -hold -from [get_regs {u_image_settings/hold_bus_*}] -to [get_pins {u_image_settings/dst_mode_*/D u_image_settings/dst_threshold_*/D}]
set_false_path -from [get_regs {u_edge_otsu_settings/req_s?}] -to [get_pins {u_edge_otsu_settings/req_meta_s?/D}]
set_false_path -from [get_regs {u_edge_otsu_settings/ack_s?}] -to [get_pins {u_edge_otsu_settings/ack_meta_s?/D}]
set_max_delay -from [get_regs {u_edge_otsu_settings/hold_bus_*}] -to [get_pins {u_edge_otsu_settings/dst_mode_*/D}] 10
set_false_path -hold -from [get_regs {u_edge_otsu_settings/hold_bus_*}] -to [get_pins {u_edge_otsu_settings/dst_mode_*/D}]
set_max_delay -from [get_clocks {clk_74_25}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_0_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_1_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_2_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_3_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_4_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_5_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_6_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_7_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_8_s1/D}] 8.0
set_false_path -hold -from [get_clocks {clk_74_25}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_0_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_1_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_2_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_3_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_4_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_5_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_6_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_7_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.wq1_rptr_8_s1/D}]
set_max_delay -from [get_clocks {clk_x1}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_0_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_1_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_2_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_3_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_4_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_5_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_6_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_7_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_8_s1/D}] 8.0
set_false_path -hold -from [get_clocks {clk_x1}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_0_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_1_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_2_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_3_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_4_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_5_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_6_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_7_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/Small.rq1_wptr_8_s1/D}]
// 2026-10-30 (b): vout_vs_n_sync0_s1 is the FIRST stage of the VFB's internal
// vsync synchroniser, i.e. a CDC entry, not a data path. The 74.25 MHz video
// vsync is already hold-cut below; its setup side was bounded at 10 ns, but that
// bound is compared against the clk_74_25->clk_x1 clock skew, which is a routing
// number with no physical meaning for an unrelated clock pair (the last PnR run
// showed 5.647 ns skew on a 10 ns relation and reported -0.308 ns). Declare the
// synchroniser input asynchronous instead of inventing a larger bound.
// dma_vs_n_d0_s0 stays bounded: it is a same-domain capture flop.
set_max_delay -from [get_clocks {clk_74_25}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/dma_vs_n_d0_s0/D}] 10.0
set_false_path -from [get_clocks {clk_74_25}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_frame_ctrl/vout_vs_n_sync0_s1/D}]
set_false_path -hold -from [get_clocks {clk_74_25}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/dma_vs_n_d0_s0/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_frame_ctrl/vout_vs_n_sync0_s1/D}]
create_generated_clock -name clk_reset_74_25 -source [get_ports {clk}] -master_clock clk -divide_by 200 -multiply_by 297 -phase 9 [get_pins {u_tmds_pll/u_pll/PLL_inst/CLKOUT2}]
set_false_path -from [get_regs {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_rd_rst_s0}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/reset_r_0_s0/PRESET Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/reset_r_1_s0/PRESET Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/reset_w_0_s0/PRESET Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/reset_w_1_s0/PRESET}]
set_false_path -from [get_regs {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/fifo_wr_rst_s0}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/fifo_write_inst/reset_r_0_s0/PRESET Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/fifo_write_inst/reset_r_1_s0/PRESET Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/fifo_write_inst/reset_w_0_s0/PRESET Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/fifo_write_inst/reset_w_1_s0/PRESET}]

// Imported and audited: vendor_scoped_control.sdc
// Manufacturer reference: https://cdn.gowinsemi.com.cn/Gowin_DDR3_Memory_Interface_RefDesign.zip
// Reference: DDR3_MC_PHY_1vs4_5a138k/project/src/ddr3_1v4_hs.sdc
// Interface 400 MHz, 1:4; current DDR3 implementation v6.0, reference implementation version not stated; grouping is a reference abstraction.
// This fragment imports exact internal control arcs; the final DDR clock group is declared separately below.
// In this fragment BOTH source and endpoint are inside u_ddr3; it adds no user-bus or video endpoint cuts.
// Includes recovery/removal for these exact internal async reset arcs, as in manufacturer clock-group intent.
// Minimum pulse width and other non-excepted timing checks remain. Exact internal control exceptions include same-domain arcs.

// ddr_single_crossing_stage_to_DQS_WLOADN
set_false_path -from [get_pins {u_ddr3/gw3_top/u_ddr_phy_top/ddr_init_internal_r_s0/Q}] -to [get_pins {u_ddr3/gw3_top/u_ddr_phy_top/wloadn_3_s0/D}]

// ddr_50MHz_reset_direct_to_functional_pins
set_false_path -from [get_clocks {clk}] -to [get_pins {u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_calibration_logic_gen?0?.rburst_neg_r_s0/CLEAR u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_calibration_logic_gen?0?.rburst_neg_s0/CLEAR u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_calibration_logic_gen?1?.rburst_neg_r_s0/CLEAR u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_calibration_logic_gen?1?.rburst_neg_s0/CLEAR u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_calibration_logic_gen?2?.rburst_neg_r_s0/CLEAR u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_calibration_logic_gen?2?.rburst_neg_s0/CLEAR u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_calibration_logic_gen?3?.rburst_neg_r_s0/CLEAR u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_calibration_logic_gen?3?.rburst_neg_s0/CLEAR u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_phy_wds/data_lane_gen?0?.u_ddr_phy_data_lane/u_ddr_phy_data_io/iserdes_gen?0?.u_ides8_mem/RESET u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_phy_wds/data_lane_gen?0?.u_ddr_phy_data_lane/u_ddr_phy_data_io/iserdes_gen?1?.u_ides8_mem/RESET u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_phy_wds/data_lane_gen?0?.u_ddr_phy_data_lane/u_ddr_phy_data_io/iserdes_gen?2?.u_ides8_mem/RESET u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_phy_wds/data_lane_gen?0?.u_ddr_phy_data_lane/u_ddr_phy_data_io/iserdes_gen?3?.u_ides8_mem/RESET u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_phy_wds/data_lane_gen?0?.u_ddr_phy_data_lane/u_ddr_phy_data_io/iserdes_gen?4?.u_ides8_mem/RESET u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_phy_wds/data_lane_gen?0?.u_ddr_phy_data_lane/u_ddr_phy_data_io/iserdes_gen?5?.u_ides8_mem/RESET u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_phy_wds/data_lane_gen?0?.u_ddr_phy_data_lane/u_ddr_phy_data_io/iserdes_gen?6?.u_ides8_mem/RESET u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_phy_wds/data_lane_gen?0?.u_ddr_phy_data_lane/u_ddr_phy_data_io/iserdes_gen?7?.u_ides8_mem/RESET}]
