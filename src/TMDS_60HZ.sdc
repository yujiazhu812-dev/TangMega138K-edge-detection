// This is the manufacturer interface timing abstraction, not a physical delay fix.
// Official DDR3 138K reference SDC abstraction, as requested.
// Only memory/UI pair is grouped. Pixel/TMDS/reset-phase remain related.
set_clock_groups -asynchronous -group [get_clocks {mem_clk}] -group [get_clocks {clk_x1}]

// 2026-10-30: asynchronous entries exposed once the PCLK period was corrected to
// the real 720p60 rate (13.468 ns). Each group below is an async clear/preset
// entry or a CDC synchronizer input: exactly the class already excepted above for
// the read side, for image_settings and for the write-FIFO pointers. No functional
// data path, clock period or FIFO bound is relaxed.
// (1) write-side reset synchronizer output: every fanout is an async reset entry
// inside the write FIFO, including the PnR-replicated copies that cannot be
// addressed by name from the SDC.
set_false_path -from [get_regs {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/fifo_wr_rst_s0}]
// (2) camera reset synchronizer entries (same treatment as u_image_settings)
set_false_path -to [get_pins {u_camera_reset/sync_ff_0_s0/CLEAR u_camera_reset/sync_ff_1_s0/CLEAR u_camera_reset/sync_ff_2_s0/CLEAR}]
// (3) DDR calibration release into the write-side async clears
set_false_path -from [get_pins {u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/ddr_init_complete_d_3_s0/Q}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/video_vs_n_s0/PRESET Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/fifo_wr_rst_s0/PRESET Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/fifo_wr_den_s0/CLEAR Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/fifo_wr_data_*_s0/CLEAR}]
// (4) camera frame sync treated like the FIFO pointer crossings: bounded, hold cut
set_max_delay -from [get_regs {u_capture/frame_vs_s0}] -to [get_pins {Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_frame_ctrl/vin_vs_n_sync0_s1/D Video_Frame_Buffer_Top_inst/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_write_ctrl/dma_vs_n_d0_s0/D}] 10
